# Dracula colors with a pure black background
theme = Dracula
background = 000000

# Transparency. 1 is opaque; 0.85, for example, lets what is behind the window show
# through. The status bar and tab strip follow it; native fullscreen stays opaque.
# Restart Ghostty after changing background-opacity.
#   background-blur          blurs what shows through: true, a strength such as 20, or
#                            on macOS 26 macos-glass-regular / macos-glass-clear
#   background-opacity-cells also lets through backgrounds that tmux or vim paint
background-opacity = 1
# background-blur = 20
# background-opacity-cells = true

# Typography
font-family = JetBrains Mono
font-size = 14

# Window appearance and session layout
window-padding-x = 10
window-padding-y = 8
macos-titlebar-style = tabs
window-inherit-working-directory = true
window-inherit-font-size = true

# Bright ice-blue dividers between native Ghostty splits
split-divider-color = 5cc8ff
unfocused-split-opacity = 0.85
unfocused-split-fill = 000000

# Keep the bar cursor steady, including at the shell prompt
cursor-style = bar
cursor-style-blink = false
cursor-color = f8f8f2
shell-integration = detect
shell-integration-features = no-cursor

# Use the account's default shell (zsh); keep shell setup in .zshrc
# Scrollback storage limit in bytes (approximately 50 MB per terminal)
scrollback-limit = 50000000

# Clipboard and keyboard behavior
copy-on-select = clipboard
mouse-hide-while-typing = true
macos-option-as-alt = true
confirm-close-surface = false

# Create splits: Command+D / Command+Shift+D
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

# Navigate splits: Command+Option+Arrow
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down

# Resize splits: Command+Control+Arrow
keybind = cmd+ctrl+left=resize_split:left,10
keybind = cmd+ctrl+right=resize_split:right,10
keybind = cmd+ctrl+up=resize_split:up,10
keybind = cmd+ctrl+down=resize_split:down,10

# Zoom the current split or make all splits equal in size
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+ctrl+equal=equalize_splits

# Reload this configuration: Command+Shift+Comma
keybind = cmd+shift+comma=reload_config

# Global dropdown terminal: Command+Backtick
# macOS Accessibility permission is required for global shortcuts
quick-terminal-position = top
quick-terminal-size = 45%
quick-terminal-screen = mouse
quick-terminal-animation-duration = 0.15
quick-terminal-autohide = true

# Isolated local test application
auto-update = off
window-save-state = always

# AI sessions in the right-click menu (New AI Session). One line per tool:
#   name:<title in the menu>,command:<what runs>,resume:<what runs after a restart>
# Each opens in a tmux session in the pane's directory. Remove a line to drop a tool;
# "macos-ai-session =" on its own removes all of them.
macos-ai-session = name:Claude Code,command:claude,resume:claude --continue
macos-ai-session = name:Codex,command:codex,resume:codex resume --last
